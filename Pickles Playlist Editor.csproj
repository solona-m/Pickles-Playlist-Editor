<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Pickles_Playlist_Editor</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationIcon>pickle.ico</ApplicationIcon>
    <AssemblyVersion>2.11.16.0</AssemblyVersion>
    <FileVersion>2.11.16.0</FileVersion>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Bundle the Windows App Runtime with the app so unpackaged builds don't
         require a machine-wide runtime install (fixes the Win10 "Windows App
         Runtime is missing" prompt). Requires a RuntimeIdentifier. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Every build ships the .NET runtime, ProjectReference builds included. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Without this, `dotnet publish` silently drops the app's own .pri resource
         index and satellite resource folders for unpackaged (WindowsPackageType=None)
         apps, causing Microsoft.ui.xaml.dll to fail at startup.
         https://github.com/microsoft/WindowsAppSDK/issues/3718 -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- devtools\ holds offline exercise rigs for the format code. They have their own project files
         and their own Main, so the app's source glob must not swallow them.
         NOT named "tools": Windows paths are case-insensitive, so that pattern also excludes the
         app's own Tools\ folder and takes the Pickles_Playlist_Editor.Tools namespace with it. -->
    <Compile Remove="devtools\**" />
    <None Remove="devtools\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScdAudioTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="pickle.ico" />
    <Content Include="Resources\pickle.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="ui\App.xaml" />
    <Page Remove="ui\App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PersistentCollection" Version="2.0.12" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <!-- Windows DPAPI, for encrypting the stored SoundCloud oauth token at rest.
         Not part of the .NET base framework; Windows-only, which suits a WinUI app. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ui\picklebackground.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="default.scd">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="ffmpeg.exe">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="licenses\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="update.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>