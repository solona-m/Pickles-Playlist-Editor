<ContentDialog
    x:Class="Pickles_Playlist_Editor.DancesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="DancesDlg"
    Title="Dances"
    CloseButtonText="Close"
    PrimaryButtonClick="PrimaryButton_Click"
    SecondaryButtonClick="SecondaryButton_Click"
    DefaultButton="Primary">

    <!-- A ContentDialog caps its own width at ContentDialogMaxWidth (548 by default), so content
         wider than that is CLIPPED rather than widening the dialog — which cut the Add button off the
         right-hand edge. Raising the cap is the supported way to widen one. -->
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">760</x:Double>
    </ContentDialog.Resources>

    <!-- MaxHeight, not just Auto scrolling: a ContentDialog grows to fit its content, so without a
         ceiling the buttons at the bottom of the add pane end up off-screen entirely. Bounded here
         and the whole thing scrolls inside the dialog instead. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
    <StackPanel Spacing="8" Width="700">

        <!-- The dances live in a DIFFERENT mod from the playlists, and saying so plainly is the whole
             reason this row is at the top rather than buried in Settings. A DJ setup is normally split
             into a music mod and a dance mod, and editing the wrong one is the mistake this feature is
             most able to cause. -->
        <TextBlock x:Uid="DanceModLabel" Text="VFX Mod" FontWeight="SemiBold"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DanceModText" Grid.Column="0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Margin="0,0,8,0"/>
            <Button x:Uid="ChangeDanceModButton" Grid.Column="1" Content="Change"
                    Click="ChangeDanceModButton_Click"/>
        </Grid>

        <!-- Shown only until a mod is chosen. Ranked rather than guessed at: the top candidate is
             usually right, but a DJ with several packs installed is exactly who this would get wrong. -->
        <StackPanel x:Name="PickerSection" Spacing="4" Visibility="Collapsed">
            <TextBlock x:Uid="DanceModPickerHint" TextWrapping="Wrap" Opacity="0.7"
                       Text="These mods look like they hold dances. Pick the one you DJ with."/>
            <ListView x:Name="CandidateList" MaxHeight="200" SelectionMode="Single"
                      SelectionChanged="CandidateList_SelectionChanged"/>
        </StackPanel>

        <StackPanel x:Name="DancesSection" Spacing="8" Visibility="Collapsed">
            <!-- Which group holds the dances is detected from its contents, not its name: plenty of
                 DJ packs have no group called "Dances". Shown and overridable because detection can
                 still pick the wrong one in a mod with several. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DanceGroupLabel" Grid.Column="0" Text="Group"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GroupCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectionChanged="GroupCombo_SelectionChanged"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DancesHeader" Grid.Column="0" VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <!-- Accented: it is the reason this dialog exists, and the only other button on
                     screen is Close, which had been the one drawing the eye. -->
                <Button x:Uid="AddDanceButton" x:Name="AddDanceButton" Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="Add a dance…" Click="AddDanceButton_Click"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DanceFilterBox" x:Uid="DanceFilterBox" Grid.Column="0"
                         Margin="0,0,4,0" PlaceholderText="Search dances"
                         TextChanged="DanceFilterBox_TextChanged"/>
                <ComboBox x:Name="DanceSortCombo" Grid.Column="1" Width="150"
                          SelectionChanged="DanceSortCombo_SelectionChanged">
                    <!-- No IsSelected here. Setting it in markup raises SelectionChanged DURING
                         InitializeComponent, and the handler touches controls declared further down
                         the file that do not exist yet — which surfaces as "XAML parsing failed"
                         with no further detail. The constructor selects the default instead. -->
                    <ComboBoxItem x:Uid="DanceSortModOrder" Content="Mod order"/>
                    <ComboBoxItem x:Uid="DanceSortName" Content="Name (A&#8211;Z)"/>
                </ComboBox>
            </Grid>

            <!-- Read-only. Renaming, removing and reordering a dance are all things Penumbra already
                 does well, and doing them here too would mean two tools writing the same option list
                 with two chances to disagree. This dialog does the one thing Penumbra cannot: prepare
                 a downloaded animation and install it. -->
            <ListView x:Name="DanceList" MaxHeight="220" SelectionMode="None" IsItemClickEnabled="False"/>
        </StackPanel>

        <!-- The add pane. Not a second ContentDialog: WinUI allows only one open at a time, which is
             also why every confirmation in here is a Win32 message box. -->
        <StackPanel x:Name="AddSection" Spacing="8" Visibility="Collapsed">
            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4"/>
            <TextBlock x:Uid="AddDanceHeader" Text="Add a dance" FontWeight="SemiBold"/>
            <TextBlock x:Uid="AddDanceHint" TextWrapping="Wrap" Opacity="0.7"
                       Text="These are the dances you already have installed in Penumbra."/>

            <TextBox x:Name="SearchBox" x:Uid="DanceSearchBox" PlaceholderText="Search"
                     TextChanged="SearchBox_TextChanged"/>
            <ListView x:Name="SourceList" MaxHeight="180" SelectionMode="Single"
                      SelectionChanged="SourceList_SelectionChanged"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="DanceNameLabel" Grid.Column="0" Text="Name" VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="DanceNameBox" Grid.Column="1" TextChanged="DanceNameBox_TextChanged"/>
            </Grid>

            <!-- No body picker. Every body the source mod ships is installed, always: leaving one out
                 fails silently — that body just plays the game's stock emote with no hint why — and
                 the cost is usually nothing, because bodies very often share a single animation file
                 that is installed once with several game paths pointing at it. -->
            <CheckBox x:Name="IncludeStartCheckBox" x:Uid="IncludeStartCheckBox"
                      Content="Also use the dance's intro animation" IsChecked="True"
                      Checked="IncludeStart_Changed" Unchecked="IncludeStart_Changed"/>

            <!-- Add and Cancel live in the dialog's own footer, not here. The footer is where the
                 accent colour is, and an accented Close beside a plain in-content "Add dance" reads
                 as an invitation to press the wrong one — worse still when the content scrolls and
                 the real action is below the fold. -->
            <TextBlock x:Name="AddPreviewText" TextWrapping="Wrap" Opacity="0.9"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.8"/>

    </StackPanel>
    </ScrollViewer>
</ContentDialog>
