<ContentDialog
    x:Class="Pickles_Playlist_Editor.SoundCloudLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="Sign in to SoundCloud"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!-- The default ContentDialog caps out around 548px wide, which clips SoundCloud's
             layout badly enough that the login form runs off the edge. Raise the ceiling
             and let the Grid below pick the real size. -->
        <x:Double x:Key="ContentDialogMaxWidth">1400</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">1200</x:Double>
    </ContentDialog.Resources>

    <Grid Width="900" Height="760">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,8"
                   TextWrapping="Wrap"
                   Text="Sign in with your SoundCloud email and password. Google and Apple sign-in usually refuse to work inside an embedded window; if that is how your account is set up, this will not be able to sign you in."/>

        <controls:WebView2 x:Name="LoginWebView" Grid.Row="1"/>

        <TextBlock x:Name="StatusLabel" Grid.Row="2" Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
    </Grid>
</ContentDialog>
